{
  "name": "channel-integration-hub",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "infra:logs": "docker compose logs -f",
    "stack:up": "docker compose -f docker-compose.full.yml up -d --build",
    "stack:down": "docker compose -f docker-compose.full.yml down",
    "stack:logs": "docker compose -f docker-compose.full.yml logs -f",
    "db:generate": "pnpm --filter @cih/database generate",
    "db:migrate": "pnpm --filter @cih/database migrate",
    "db:seed": "pnpm --filter @cih/database seed",
    "db:studio": "pnpm --filter @cih/database studio",
    "build": "pnpm -r run build",
    "dev:api": "pnpm --filter @cih/api dev",
    "dev:partners": "pnpm --filter @cih/mock-partners dev",
    "test": "pnpm --filter @cih/api test",
    "test:cov": "pnpm --filter @cih/api test:cov",
    "test:e2e": "pnpm --filter @cih/api test:e2e",
    "typecheck": "pnpm --filter @cih/shared build && pnpm --filter @cih/database generate && pnpm --filter @cih/api exec tsc --noEmit && pnpm --filter @cih/mock-partners exec tsc --noEmit && pnpm --filter @cih/web exec tsc --noEmit",
    "lint": "prettier --check .",
    "format:check": "prettier --check .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prettier": "^3.3.0",
    "rimraf": "^6.0.0",
    "typescript": "^5.5.0"
  },
  "packageManager": "pnpm@9.12.0"
}
